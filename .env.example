NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# 선택사항: /api/cron/weekly-data 를 로컬에서 직접 테스트할 때만 필요합니다.
# 실제 배포(Vercel)에서는 Vercel이 자동으로 만들어주므로 따로 설정하지 않아도 됩니다.
# CRON_SECRET=your_local_test_secret

# 선택사항: 구글 로그인 + 기기 간 동기화 (Firebase). 비워두면 로그인 버튼이 숨겨지고 기기(localStorage)에만 저장돼요.
# Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹) 에서 확인할 수 있어요.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
